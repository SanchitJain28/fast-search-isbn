# Reporting is opt-in. All scanning decisions and history stay on the central server.
SHEETS_SYNC_ENABLED=false
SHEETS_SPREADSHEET_ID=
# Use a NEW tab name; the software creates it. Do not pre-create it or edit its rows.
SHEETS_SCANNER_TAB=Scanner Log
# Optional: absolute paths. Otherwise credentials.json and data/packing.sqlite are used.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/credentials.json
# PACKING_DB=/absolute/path/packing.sqlite

# Required by npm start (production HTTP server). Generate a salted hash with scripts/hash-password.mjs.
SCANNER_USERNAME=bookpacker
SCANNER_PASSWORD_HASH=
HOST=127.0.0.1
PORT=3000
# Reporting batch size: default 100, maximum 1000.
SHEETS_BATCH_SIZE=100

# Set to the exact HTTPS address when using a reverse proxy.
# PUBLIC_ORIGIN=https://scanner.example.com

# Cover lookup is opt-in. Keep the Gemini key server-side.
COVER_MATCH_ENABLED=false
COVER_MATCH_AUTO_PACK=off
COVER_VISION_PROVIDER=gemini
COVER_VISION_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
COVER_MATCH_MIN_SCORE=75
COVER_MATCH_AUTO_THRESHOLD=90
COVER_MATCH_GAP_MIN=8

# Opt in to front-cover similarity search. Select the cover-with-text collection.
COVER_VECTOR_SEARCH_ENABLED=false
# Set this to a station ID to limit vector search and enable same-photo comparison there.
# COVER_VECTOR_PILOT_STATION=Station-example
# QDRANT_URL=http://127.0.0.1:6335
# QDRANT_API_KEY=
# COVER_VECTOR_COLLECTION=isbn_phase2_your_collection_cover_with_text
# COVER_VECTOR_REVIEW_COLLECTION=isbn_covers_your_review_collection
COVER_VECTOR_MIN_SCORE=0.623026
COVER_VECTOR_MIN_GAP=0.02219
